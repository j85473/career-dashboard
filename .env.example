# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/career_db"

# API keys for unrelated manual-ingestion, LinkedIn, outreach, and tailoring
# features. Native Context DB and scoring never read these keys.
GEMINI_API_KEY="your_gemini_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Local native Antigravity scoring (Mac only; no model API key is used)
AGY_BIN="/Users/your-user/.local/bin/agy"
# Optional after `agy --new-project agents`; the watcher can auto-discover it.
AGY_PROJECT_ID="00000000-0000-4000-8000-000000000000"

# Scraping / Data Source APIs
SERPAPI_KEY="your_serpapi_key_here"
RAPIDAPI_KEY="your_rapidapi_key_here"
ADZUNA_APP_KEY="your_adzuna_app_key_here"
ADZUNA_APP_ID="your_adzuna_app_id_here"

CAREERONESTOP_USER_ID="your_careeronestop_user_id_here"
CAREERONESTOP_TOKEN="your_careeronestop_token_here"

# Fallback/Secondary API Keys (Optional)
SERPAPI_KEY_2="your_second_serpapi_key_here"
RAPIDAPI_KEY_2="your_second_rapidapi_key_here"

# Job source integrations (optional)
APIFY_API_TOKEN="your_apify_token_here"
JINA_API_KEY="your_jina_key_here"
USAJOBS_API_KEY="your_usajobs_api_key_here"
USAJOBS_USER_AGENT="your-email@example.com"

# Pipeline automation. The Career Dashboard intentionally has no login screen.
PIPELINE_SECRET="replace_with_a_different_long_random_secret"
DASHBOARD_URL="http://localhost:3000"
