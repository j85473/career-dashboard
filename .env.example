# Database Connection
DATABASE_URL="postgresql://user:password@localhost:5432/career_db"

# API keys for unrelated manual-ingestion, LinkedIn, outreach, and tailoring
# features. The manual scoring exchange never reads these keys.
GEMINI_API_KEY="your_gemini_api_key_here"
DEEPSEEK_API_KEY="your_deepseek_api_key_here"

# Scraping / Data Source APIs
SERPAPI_KEY="your_serpapi_key_here"
RAPIDAPI_KEYS="your_rapidapi_key_here,your_second_rapidapi_key_here"
ADZUNA_APP_KEY="your_adzuna_app_key_here"
ADZUNA_APP_ID="your_adzuna_app_id_here"

CAREERONESTOP_USER_ID="your_careeronestop_user_id_here"
CAREERONESTOP_TOKEN="your_careeronestop_token_here"

# Fallback/Secondary API Keys (Optional)
SERPAPI_KEY_2="your_second_serpapi_key_here"

# Job source integrations (optional)
APIFY_API_TOKEN="your_apify_token_here"
JINA_API_KEY="your_jina_key_here"
USAJOBS_API_KEY="your_usajobs_api_key_here"
USAJOBS_USER_AGENT="your-email@example.com"

# Pipeline automation. The Career Dashboard intentionally has no login screen.
PIPELINE_SECRET="replace_with_a_different_long_random_secret"
SCORING_APPROVAL_SECRET="replace_with_at_least_32_random_bytes"
DASHBOARD_URL="http://localhost:3000"

# ATS acquisition ledger rollout controls. Phase 1 ships the additive schema
# and compatibility fences only; every v2 behavior remains disabled.
ATS_ACQUISITION_LEDGER_V2_ENABLED="false"
ATS_ACQUISITION_LEDGER_SHADOW_ENABLED="false"
ATS_ACQUISITION_LEDGER_CONVERSION_ENABLED="false"
ATS_ACQUISITION_SEGMENT_PUBLICATION_ENABLED="false"
# During a canary, v2 borrows this many of the four acquisition slots and the
# legacy path retains the rest. The cap of three always leaves a legacy drain
# lane until every old partial is converted or processed.
ATS_ACQUISITION_LEDGER_V2_SLOTS="2"
ATS_LEDGER_OBSERVATION_CHUNK_SIZE="250"
ATS_LEDGER_MARKER_CHUNK_SIZE="250"
ATS_LEDGER_LISTING_PAGE_BUDGET="5"
ATS_LEDGER_DETAIL_REQUEST_BUDGET="5"
ATS_LEDGER_QUANTUM_SOFT_MS="45000"
ATS_LEDGER_STAGING_ITEM_HIGH_WATERMARK="100000"
ATS_LEDGER_STAGING_BYTE_HIGH_WATERMARK="1500000000"
