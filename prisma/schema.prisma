generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  binaryTargets   = ["native", "linux-arm64-openssl-1.1.x", "linux-arm64-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pg_trgm, btree_gist]
}

model Job {
  id                    String                     @id @default(uuid())
  title                 String
  company               String
  description           String?
  location              String?
  url                   String?
  source                String?
  sourceId              String?
  canonicalUrl          String?
  // `fingerprint` is a legacy unique candidate key and remains nullable for
  // rollout compatibility. New ingestion leaves it null and writes the
  // non-unique `identityFingerprint` instead, so ambiguous display-label
  // matches can coexist. `postingIdentity` is populated only for a stable
  // source/requisition identity.
  //
  // `@unique` is the only index this column needs. A redundant non-unique
  // `@@index([fingerprint])` also existed and was dropped: on identical
  // columns the planner can never prefer it over the unique index.
  fingerprint           String?                    @unique
  identityFingerprint   String?
  postingIdentity       String?                    @unique
  postedAt              DateTime
  status                String                     @default("pending_af")
  scoringStatus         String                     @default("queued")
  scoreAttempts         Int                        @default(0)
  scoreError            String?
  fitScore              Int?
  fitCategory           String                     @default("unscored")
  fitRationale          String?
  tailoringAdvice       String?
  recommendedResume     String?
  tailoringStaged       Boolean                    @default(false)
  passReason            String?
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  manualAts             String?
  batchJobId            String?
  experienceStatus      String                     @default("queued")
  reqFitRationale       String?
  reqFitScore           Int?
  afBatchId             String?
  contextBatched        Boolean                    @default(false)
  contextBatchId        String?
  jdBatchId             String?
  verificationStatus    String                     @default("pending")
  travelScore           Int?
  aimFitScore           Int?
  contextPacket         String?
  submittedResume       String?
  cooldownUntil         DateTime?
  compensation          String?
  // Deterministically extracted from the stored JD; never an Aim/Experience
  // assessment or an inferred total-compensation value.
  postedCompensation    String?
  // The travel expectation the posting states outright ("up to 50%", "none
  // stated"). Text, not a score: travelScore below is the retired pre-v2
  // numeric field and is no longer written by anything.
  postedTravel          String?
  deepseekScoreAttempts Int                        @default(0)
  deepseekScoreError    String?
  lastVerifiedAt        DateTime?
  observations          JobSourceObservation[]
  statusHistory         JobStatusHistory[]
  scoringStatusHistory  JobScoringStatusHistory[]
  pipelineEvents        JobPipelineEvent[]
  scoreEvents           JobScoreEvent[]
  scoringBatchItems     ScoringBatchItem[]
  scoringArtifacts      JobScoringArtifact[]
  aimFactualExtractions AimFactualExtraction[]
  aimFailureReceipts    AimScoringFailureReceipt[]

  @@index([status])
  @@index([scoringStatus])
  @@index([identityFingerprint])
  @@index([status, aimFitScore])
  @@index([status, createdAt])
  @@index([status, updatedAt])
  @@index([tailoringStaged])
  @@index([scoringStatus, status, aimFitScore])
  @@index([scoringStatus, deepseekScoreAttempts])
  @@index([contextBatchId])
  @@index([canonicalUrl])
  /// Ingestion deduplication compares lower("canonicalUrl"), which Prisma
  /// cannot express here. The 20260829180000 migration owns the matching
  /// "Job_canonicalUrl_lower_idx" expression index; without it that lookup
  /// falls back to a full scan on every incoming job.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([company(ops: raw("gin_trgm_ops"))], type: Gin)
  /// `description` deliberately has no trigram index. One existed and was
  /// dropped: descriptions average ~2.1KB and live in TOAST, so a trigram
  /// match could only ever be a candidate filter, and the recheck had to
  /// de-TOAST every candidate. Measured, `title ILIKE` returned in 0.67s
  /// while the same query on `description` had not finished in 12s. The
  /// index cost 2838MB -- a quarter of the database -- and never made
  /// description search viable. Full-text search is the correct shape.
  @@index([source])
  @@index([createdAt])
}

model JobSourceObservation {
  id            String         @id @default(uuid())
  jobId         String
  source        String
  sourceId      String
  url           String?
  searchQuery   String?
  ingestionMode String?
  queryFamily   String?
  geoLane       String?
  windowStart   DateTime?
  windowEnd     DateTime?
  taskId        String?
  observedAt    DateTime       @default(now())
  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  task          IngestionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@unique([source, sourceId])
  @@index([jobId])
  @@index([taskId, observedAt])
  @@index([geoLane, observedAt])
}

model UserPreference {
  id        String   @id @default(uuid())
  text      String
  type      String
  createdAt DateTime @default(now())
}

model UsageTracking {
  id           String @id @default(uuid())
  date         String @unique
  tokens       Int    @default(0)
  inputTokens  Int    @default(0)
  outputTokens Int    @default(0)
  cost         Float  @default(0)
}

model UsedArticle {
  id        String   @id @default(uuid())
  url       String   @unique
  status    String
  createdAt DateTime @default(now())
}

model LinkedInDraft {
  id        String   @id @default(uuid())
  title     String
  postText  String
  url       String
  createdAt DateTime @default(now())
}

model AtsCompany {
  slug               String
  platform           String
  status             String                           @default("active")
  failCount          Int                              @default(0)
  retryCount         Int                              @default(0)
  nextCheckDate      DateTime                         @default(now())
  jobsFound          Int                              @default(0)
  discoveredAt       DateTime                         @default(now())
  /// Compatibility timestamp for a completed board synchronization. New
  /// telemetry separates contact, response, synchronization, and processing.
  lastCheckedAt      DateTime?
  lastAttemptedAt    DateTime?
  lastRespondedAt    DateTime?
  lastSynchronizedAt DateTime?
  lastProcessedAt    DateTime?
  /// Legacy remains the only active engine in Phase 1. The compatibility
  /// writer and database triggers exclude converting/v2 boards before a
  /// legacy attempt or payload mutation can start.
  acquisitionEngine  String                           @default("legacy")
  /// Assigned sweep weekday, 0 = Sunday through 6 = Saturday. Deliberately has
  /// no Prisma default: every creation site must assign a cohort via
  /// assignedRotationDay, or the rotation silently piles new boards onto Sunday.
  /// The database keeps a default so raw-SQL inserts cannot fail.
  checkDay           Int
  /// Why this board left the rotation, and when. Set only for status
  /// 'excluded'. Null on a board excluded before this audit trail existed.
  excludedReason     String?
  excludedAt         DateTime?
  checkAttempts      AtsBoardCheckAttempt[]
  ingestionBatches   AtsIngestionBatch[]
  endpointSweeps     AtsEndpointSweepReceipt[]
  dailyContacts      AtsEndpointDailyContactReceipt[]

  @@id([slug, platform])
  @@index([status, nextCheckDate])
  @@index([status, checkDay])
  @@index([status, checkDay, lastAttemptedAt])
  @@index([acquisitionEngine, status, nextCheckDate])
  @@index([platform])
}

/// Append-only receipt for one worker claim against one direct ATS board.
/// A timeout proves an attempt happened without being misreported as a valid
/// response or a completed synchronization.
model AtsBoardCheckAttempt {
  id               String                      @id @default(uuid())
  slug             String
  platform         String
  batchId          String?
  outcome          String                      @default("running")
  leaseOwner       String?
  heartbeatAt      DateTime?
  leaseExpiresAt   DateTime?
  httpStatus       Int?
  requestCount     Int                         @default(0)
  pageCount        Int                         @default(0)
  jobCount         Int                         @default(0)
  startedAt        DateTime                    @default(now())
  contactedAt      DateTime?
  respondedAt      DateTime?
  synchronizedAt   DateTime?
  processedAt      DateTime?
  finishedAt       DateTime?
  durationMs       Int?
  error            String?
  /// Phase 0 telemetry: this claim-grain field is deliberately separate from
  /// exact endpoint-contact authority in AtsEndpointDailyContactReceipt.
  workKind         String                      @default("legacy_claim")
  transactionPhase String?
  failureScope     String?
  createdAt        DateTime                    @default(now())
  board            AtsCompany                  @relation(fields: [slug, platform], references: [slug, platform], onDelete: Restrict)
  batch            AtsIngestionBatch?          @relation(fields: [batchId], references: [id], onDelete: SetNull)
  workReceipts     AtsAcquisitionWorkReceipt[]

  @@index([slug, platform, startedAt])
  @@index([outcome, startedAt])
  @@index([outcome, leaseExpiresAt])
  @@index([batchId])
  @@index([contactedAt])
  @@index([respondedAt])
  @@index([synchronizedAt])
  @@index([processedAt])
  @@index([finishedAt])
  @@index([workKind, startedAt])
  @@index([transactionPhase, startedAt])
  @@index([failureScope, startedAt])
}

/// Durable handoff between the direct-ATS acquisition workers and the slower
/// normalization/persistence consumer. The payload is consumed only after the
/// batch finishes; its hash and audit counters remain.
model AtsIngestionBatch {
  id                        String                            @id @default(uuid())
  slug                      String
  platform                  String
  status                    String                            @default("fetching")
  payload                   Json?
  payloadHash               String?
  metadata                  Json?
  cursor                    Json?
  requestCount              Int                               @default(0)
  pageCount                 Int                               @default(0)
  jobCount                  Int                               @default(0)
  insertedCount             Int                               @default(0)
  duplicateCount            Int                               @default(0)
  filteredCount             Int                               @default(0)
  processingErrorCount      Int                               @default(0)
  processingAttemptCount    Int                               @default(0)
  processingOffset          Int                               @default(0)
  nextProcessAt             DateTime?
  leaseToken                String?                           @unique
  leaseOwner                String?
  leaseStartedAt            DateTime?
  heartbeatAt               DateTime?
  leaseExpiresAt            DateTime?
  startedAt                 DateTime                          @default(now())
  respondedAt               DateTime?
  synchronizedAt            DateTime?
  processedAt               DateTime?
  lastError                 String?
  createdAt                 DateTime                          @default(now())
  updatedAt                 DateTime                          @updatedAt
  /// Phase 1 ledger fields are expand-only and dormant while writerMode is
  /// legacy. The JSON payload/cursor remain the authority until an explicit,
  /// fenced conversion activates a later ledger generation.
  ledgerVersion             Int                               @default(1)
  writerMode                String                            @default("legacy")
  acquisitionPhase          String                            @default("listing")
  nextAcquireAt             DateTime?
  lastServedAt              DateTime?
  listingGeneration         Int                               @default(0)
  listingOffset             Int                               @default(0)
  latestObservedTotal       Int?
  listingCompletedAt        DateTime?
  rawObservationCount       Int                               @default(0)
  canonicalOccurrenceCount  Int                               @default(0)
  compactedOccurrenceCount  Int                               @default(0)
  terminalItemCount         Int                               @default(0)
  sealedItemCount           Int                               @default(0)
  publishedItemCount        Int                               @default(0)
  acquisitionBytes          BigInt                            @default(0)
  manifestHash              String?
  activeLedgerGeneration    Int                               @default(0)
  conversionGeneration      Int                               @default(0)
  segmentSize               Int                               @default(25)
  acquisitionClaimToken     String?                           @unique
  acquisitionClaimOwner     String?
  acquisitionClaimFence     BigInt                            @default(0)
  acquisitionHeartbeatAt    DateTime?
  acquisitionLeaseExpiresAt DateTime?
  archiveEligibleAt         DateTime?
  archivePartitionDay       DateTime?                         @db.Date
  archiveLocation           String?
  archiveContentHash        String?
  archiveBytes              BigInt?
  archiveVerifiedAt         DateTime?
  operatorResetAt           DateTime?
  operatorResetReason       String?
  operatorResetAbandonedItems Int                              @default(0)
  board                     AtsCompany                        @relation(fields: [slug, platform], references: [slug, platform], onDelete: Restrict)
  attempts                  AtsBoardCheckAttempt[]
  pages                     AtsIngestionPage[]
  observations              AtsListingObservation[]
  observationResolutions    AtsListingObservationResolution[]
  items                     AtsIngestionItem[]
  workReceipts              AtsAcquisitionWorkReceipt[]
  endpointSweep             AtsEndpointSweepReceipt?
  segments                  AtsIngestionSegment[]
  zeroJobFailureResolution  AtsZeroJobFailureResolution?

  /// The migration also owns a partial unique index permitting only one
  /// fetching/partial batch per board while still allowing immutable completed
  /// and future weekly batch receipts to coexist.

  @@index([status, createdAt])
  @@index([status, nextProcessAt, createdAt])
  @@index([slug, platform, status, createdAt])
  @@index([leaseExpiresAt])
  @@index([writerMode, acquisitionPhase, nextAcquireAt, lastServedAt])
  @@index([acquisitionLeaseExpiresAt])
  @@index([archivePartitionDay, archiveEligibleAt])
}

/// Immutable provider page response within one listing traversal generation.
model AtsIngestionPage {
  id                        String                  @id @default(uuid())
  batchId                   String
  generation                Int
  requestedOffset           Int
  requestedLimit            Int
  providerOffset            Int?
  providerTotal             Int?
  responseItemCount         Int
  responseHash              String
  identityMultisetHash      String
  metadata                  Json?
  rawBody                   Json?
  rawBodyHash               String?
  rawBodyBytes              BigInt                  @default(0)
  materializationOffset     Int                     @default(0)
  requestedAt               DateTime
  respondedAt               DateTime
  httpStatus                Int
  materializationCompleteAt DateTime?
  partitionDay              DateTime                @default(now()) @db.Date
  createdAt                 DateTime                @default(now())
  batch                     AtsIngestionBatch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observations              AtsListingObservation[]

  @@unique([batchId, generation, requestedOffset])
  @@index([batchId, generation, requestedOffset])
  @@index([partitionDay, createdAt])
}

/// Every raw listing occurrence remains immutable evidence, including
/// deliberate verification generations and repeated provider identities.
model AtsListingObservation {
  id               String                           @id @default(uuid())
  batchId          String
  pageId           String
  generation       Int
  pageOrdinal      Int
  providerSourceId String?
  rawHash          String
  rawJson          Json?
  rawSliceOffset   Int?
  rawSliceLength   Int?
  observedAt       DateTime
  partitionDay     DateTime                         @default(now()) @db.Date
  createdAt        DateTime                         @default(now())
  batch            AtsIngestionBatch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  page             AtsIngestionPage                 @relation(fields: [pageId], references: [id], onDelete: Restrict)
  resolution       AtsListingObservationResolution?
  representedItems AtsIngestionItem[]               @relation("RepresentativeObservation")

  @@unique([pageId, pageOrdinal])
  @@index([batchId, generation, providerSourceId])
  @@index([batchId, generation, rawHash])
  @@index([partitionDay, observedAt])
}

/// One explicit resolution per immutable raw observation. Verification,
/// drift, compaction, and unresolved anomalies remain visible even when they
/// do not create another consumer item.
model AtsListingObservationResolution {
  id               String                @id @default(uuid())
  batchId          String
  observationId    String                @unique
  itemId           String?
  ledgerGeneration Int                   @default(0)
  resolutionType   String
  occurrenceKey    String?
  resolutionHash   String
  detail           Json?
  partitionDay     DateTime              @default(now()) @db.Date
  createdAt        DateTime              @default(now())
  batch            AtsIngestionBatch     @relation(fields: [batchId], references: [id], onDelete: Restrict)
  observation      AtsListingObservation @relation(fields: [observationId], references: [id], onDelete: Restrict)
  item             AtsIngestionItem?     @relation("ResolvedItem", fields: [itemId], references: [id], onDelete: Restrict)

  @@index([batchId, ledgerGeneration, resolutionType])
  @@index([itemId])
  @@index([partitionDay, createdAt])
}

/// Canonical acquisition work is row-granular. The raw listing remains
/// immutable; enrichment writes only a small overlay and fenced item state.
model AtsIngestionItem {
  id                          String                            @id @default(uuid())
  batchId                     String
  ledgerGeneration            Int                               @default(0)
  canonicalOrdinal            Int
  representativeObservationId String?
  providerSourceId            String?
  rawHash                     String
  rawJson                     Json?
  rawReference                Json?
  enrichmentOverlay           Json?
  enrichmentVersion           Int?
  enrichmentStatus            String                            @default("pending")
  enrichmentReason            String?
  detailHttpStatus            Int?
  detailError                 String?
  detailAttemptCount          Int                               @default(0)
  nextDetailAt                DateTime?
  terminalAt                  DateTime?
  itemClaimToken              String?                           @unique
  itemClaimOwner              String?
  itemClaimFence              BigInt                            @default(0)
  itemHeartbeatAt             DateTime?
  itemLeaseExpiresAt          DateTime?
  partitionDay                DateTime                          @default(now()) @db.Date
  createdAt                   DateTime                          @default(now())
  updatedAt                   DateTime                          @updatedAt
  batch                       AtsIngestionBatch                 @relation(fields: [batchId], references: [id], onDelete: Restrict)
  representativeObservation   AtsListingObservation?            @relation("RepresentativeObservation", fields: [representativeObservationId], references: [id], onDelete: Restrict)
  resolutions                 AtsListingObservationResolution[] @relation("ResolvedItem")

  @@unique([batchId, ledgerGeneration, canonicalOrdinal])
  @@index([batchId, ledgerGeneration, enrichmentStatus, nextDetailAt, canonicalOrdinal])
  @@index([batchId, ledgerGeneration, providerSourceId])
  @@index([itemLeaseExpiresAt])
  @@index([partitionDay, createdAt])
}

/// Append-only receipt for one bounded scheduler quantum. This is scheduler
/// telemetry, not endpoint-contact authority.
model AtsAcquisitionWorkReceipt {
  id                  String                           @id @default(uuid())
  batchId             String
  legacyAttemptId     String?
  endpointSweepId     String?
  workType            String
  startGeneration     Int?
  endGeneration       Int?
  startListingOffset  Int?
  endListingOffset    Int?
  startItemOrdinal    Int?
  endItemOrdinal      Int?
  listingRequestCount Int                              @default(0)
  detailRequestCount  Int                              @default(0)
  itemsInspected      Int                              @default(0)
  itemsTerminalized   Int                              @default(0)
  itemsProgressed     Int                              @default(0)
  startedAt           DateTime                         @default(now())
  finishedAt          DateTime?
  heartbeatAt         DateTime?
  leaseOwner          String?
  leaseToken          String?                          @unique
  leaseFence          BigInt                           @default(0)
  leaseExpiresAt      DateTime?
  yieldReason         String?
  checkpointHash      String?
  transactionPhase    String?
  failureScope        String?
  ambiguousDispatch   Boolean                          @default(false)
  adoptedCheckpoint   Boolean                          @default(false)
  error               String?
  partitionDay        DateTime                         @default(now()) @db.Date
  createdAt           DateTime                         @default(now())
  batch               AtsIngestionBatch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  legacyAttempt       AtsBoardCheckAttempt?            @relation(fields: [legacyAttemptId], references: [id], onDelete: SetNull)
  endpointSweep       AtsEndpointSweepReceipt?         @relation(fields: [endpointSweepId], references: [id], onDelete: SetNull)
  dailyContacts       AtsEndpointDailyContactReceipt[]

  @@index([workType, startedAt])
  @@index([batchId, startedAt])
  @@index([leaseExpiresAt])
  @@index([transactionPhase, startedAt])
  @@index([partitionDay, createdAt])
}

/// One board-cycle aggregate. Dispatch retries remain separate work receipts;
/// a crash-ambiguous intent cannot count as a confirmed contact.
model AtsEndpointSweepReceipt {
  id                 String                           @id @default(uuid())
  batchId            String                           @unique
  slug               String
  platform           String
  admissionLocalDay  DateTime                         @db.Date
  /// Scheduling bucket at admission. Unlike the board's mutable status, this
  /// remains stable after a successful cooldown retry returns it to active.
  selectionTier      String                           @default("unclassified")
  state              String                           @default("admitted")
  admittedAt         DateTime                         @default(now())
  dispatchIntentAt   DateTime?
  contactConfirmedAt DateTime?
  respondedAt        DateTime?
  synchronizedAt     DateTime?
  processedAt        DateTime?
  outcome            String?
  safetyBlockReason  String?
  createdAt          DateTime                         @default(now())
  updatedAt          DateTime                         @updatedAt
  batch              AtsIngestionBatch                @relation(fields: [batchId], references: [id], onDelete: Restrict)
  board              AtsCompany                       @relation(fields: [slug, platform], references: [slug, platform], onDelete: Restrict)
  workReceipts       AtsAcquisitionWorkReceipt[]
  dailyContacts      AtsEndpointDailyContactReceipt[]

  @@index([admissionLocalDay, state])
  @@index([selectionTier, processedAt])
  @@index([slug, platform, admittedAt])
}

/// Exact daily contact authority. localDay comes from the confirmed Chicago
/// transport time, so an admission or ambiguous retry crossing midnight is
/// credited only to the day on which contact became durable.
model AtsEndpointDailyContactReceipt {
  id                 String                     @id @default(uuid())
  localDay           DateTime                   @db.Date
  slug               String
  platform           String
  contactKind        String
  contactConfirmedAt DateTime
  sweepId            String?
  workReceiptId      String?
  createdAt          DateTime                   @default(now())
  board              AtsCompany                 @relation(fields: [slug, platform], references: [slug, platform], onDelete: Restrict)
  sweep              AtsEndpointSweepReceipt?   @relation(fields: [sweepId], references: [id], onDelete: SetNull)
  workReceipt        AtsAcquisitionWorkReceipt? @relation(fields: [workReceiptId], references: [id], onDelete: SetNull)

  @@unique([localDay, slug, platform, contactKind])
  @@index([contactKind, contactConfirmedAt])
  @@index([sweepId])
}

/// Immutable bounded handoff manifest. Segment bounds are deterministic and
/// database constraints enforce size and non-overlap.
model AtsIngestionSegment {
  id                   String            @id @default(uuid())
  batchId              String
  ledgerGeneration     Int               @default(0)
  segmentOrdinal       Int
  segmentSize          Int
  firstOrdinal         Int
  lastOrdinal          Int
  itemCount            Int
  manifestHash         String
  enrichmentVersion    Int
  status               String            @default("sealed")
  processingOffset     Int               @default(0)
  insertedCount        Int               @default(0)
  duplicateCount       Int               @default(0)
  filteredCount        Int               @default(0)
  processingErrorCount Int               @default(0)
  nextProcessAt        DateTime?
  leaseToken           String?           @unique
  leaseOwner           String?
  leaseFence           BigInt            @default(0)
  heartbeatAt          DateTime?
  leaseExpiresAt       DateTime?
  sealedAt             DateTime          @default(now())
  publishedAt          DateTime?
  processedAt          DateTime?
  partitionDay         DateTime          @default(now()) @db.Date
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  batch                AtsIngestionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@unique([batchId, ledgerGeneration, segmentOrdinal])
  @@unique([batchId, ledgerGeneration, firstOrdinal, lastOrdinal])
  @@index([status, nextProcessAt, createdAt])
  @@index([batchId, ledgerGeneration, firstOrdinal])
  @@index([leaseExpiresAt])
  @@index([partitionDay, createdAt])
}

/// Singleton capability gate checked by compatible acquisition workers. The
/// database triggers remain the final protection from a pre-v2 binary.
model AtsAcquisitionRuntimeGate {
  id                              String    @id @default("global")
  minimumWriterVersion            Int       @default(1)
  compatibilityWriterVersion      Int       @default(2)
  compatibilityActivatedAt        DateTime  @default(now())
  v2AuthorityActivatedAt          DateTime?
  activatedLedgerVersion          Int?
  /// `draining` pauses only new board admissions. Already-durable listing,
  /// enrichment, sealing, publication, and persistence work remains runnable.
  admissionState                  String    @default("open")
  admissionResumeAt               DateTime?
  drainRequestedAt                DateTime?
  cutoverReadyAt                  DateTime?
  /// Distributed execution is a separate authority gate from ledger v2. The
  /// default remains Pi-only until an explicit compatibility activation.
  distributedAuthorityActivatedAt DateTime?
  distributedWriterVersion        Int       @default(0)
  remoteWorkersEnabled            Boolean   @default(false)
  globalSlotLimit                 Int       @default(4)
  localSlotReserve                Int       @default(4)
  publicationPaused               Boolean   @default(false)
  publicationPausedAt             DateTime?
  publicationBacklogJobs          Int       @default(0)
  updatedAt                       DateTime  @updatedAt
}

/// Database-backed capacity shared by the Pi acquisition child and optional
/// remote continuation workers. A lease is advisory capacity only; the work
/// receipt and batch/item fences remain the authority for every mutation.
model AtsAcquisitionWorkerSlot {
  slotNumber     Int       @id
  leaseOwner     String?
  leaseToken     String?   @unique
  leaseFence     BigInt    @default(0)
  workerKind     String?
  releaseId      String?
  acquiredAt     DateTime?
  heartbeatAt    DateTime?
  leaseExpiresAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@index([leaseExpiresAt])
  @@index([workerKind, heartbeatAt])
}

/// Immutable proof that admission was paused and every pre-cutover lifecycle
/// stage reconciled to zero. It records evidence; it never erases or grants
/// authority over the retained acquisition receipts.
model AtsAcquisitionCutoverReceipt {
  id                  String   @id @default(uuid())
  verifiedAt          DateTime @default(now())
  localDay            DateTime @db.Date
  dailyTarget         Int
  confirmedContacts   Int
  snapshot            Json
  snapshotHash        String   @unique
  lastLegacyAttemptId String?
  lastV2WorkReceiptId String?
  lastV2SegmentId     String?
  exceptionCount      Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([verifiedAt])
  @@index([localDay])
}

/// Append-only proof that one terminal provider failure contained no jobs or
/// downstream work. The failed batch remains unchanged; this receipt only
/// removes a proven-empty attempt from the clean-cutover unresolved count.
model AtsZeroJobFailureResolution {
  id             String            @id @default(uuid())
  batchId        String            @unique
  resolutionKind String
  evidence       Json
  evidenceHash   String            @unique
  resolvedAt     DateTime          @default(now())
  createdAt      DateTime          @default(now())
  batch          AtsIngestionBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)

  @@index([resolutionKind, resolvedAt])
}

model ContextProfile {
  id              String        @id @default("global")
  rulesText       String
  updatedAt       DateTime      @updatedAt
  batchJobId      String?
  linkedinBatchId String?
  rules           ContextRule[]
}

/// Typed, scoped rules replace freeform Context gradually. `rulesText` stays
/// on ContextProfile until all readers are migrated and replay-validated.
model ContextRule {
  id                String         @id @default(uuid())
  contextProfileId  String
  ruleKey           String         @unique
  dimension         String
  scope             String
  ruleText          String
  sourceDecisionIds String[]       @default([])
  confidence        Float?
  active            Boolean        @default(true)
  createdAt         DateTime       @default(now())
  lastConfirmedAt   DateTime?
  retiredAt         DateTime?
  retiredReason     String?
  provenance        Json?
  contextProfile    ContextProfile @relation(fields: [contextProfileId], references: [id], onDelete: Cascade)

  @@index([active, dimension])
  @@index([contextProfileId])
}

model ContextRuleRevision {
  id                String   @id @default(uuid())
  contextProfileId  String
  previousRulesText String
  newRulesText      String
  sourceJobIds      String[]
  model             String
  promptVersion     String
  requestId         String?
  idempotencyKey    String?  @unique
  schemaVersion     String?
  batchId           String?
  chunkId           String?
  inputHash         String?
  contextHash       String?
  manifestHash      String?
  resultHash        String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([batchId])
}

model AiUsageEvent {
  id               String   @id @default(uuid())
  provider         String
  purpose          String
  status           String
  model            String
  requestId        String?
  batchSize        Int      @default(0)
  latencyMs        Int
  attempt          Int      @default(1)
  finishReason     String?
  promptTokens     Int      @default(0)
  cacheHitTokens   Int      @default(0)
  cacheMissTokens  Int      @default(0)
  completionTokens Int      @default(0)
  reasoningTokens  Int      @default(0)
  totalTokens      Int      @default(0)
  estimatedCost    Float    @default(0)
  error            String?
  createdAt        DateTime @default(now())

  @@index([provider, createdAt])
  @@index([purpose, createdAt])
}

model JobScoreEvent {
  id                              String                @id @default(uuid())
  jobId                           String
  evaluationType                  String
  model                           String
  promptVersion                   String
  policyVersion                   String?
  requestId                       String?
  idempotencyKey                  String?               @unique
  schemaVersion                   String?
  chunkId                         String?
  promptHash                      String?
  evidenceHash                    String?
  inputHash                       String?
  evidenceIds                     String[]              @default([])
  qualificationBasis              String?
  mandatoryRequirementAssessments Json?
  batchId                         String?
  manifestHash                    String?
  resultHash                      String?
  contextHash                     String?
  contextProfileUpdatedAt         DateTime?
  aimFitScore                     Int?
  experienceFitScore              Int?
  travelScore                     Int?
  domainMatch                     Boolean?
  requiredDomain                  String?
  candidateDomain                 String?
  requiredYearsInDomain           Float?
  candidateYearsInDomain          Float?
  passed                          Boolean
  aimReason                       String?
  experienceReason                String?
  staleAt                         DateTime?
  staleReason                     String?
  batchItemId                     String?               @unique
  sourceAimEventId                String?
  cleanedJdArtifactId             String?
  decisionCode                    String?
  aimAssessments                  Json?
  travelAssessment                Json?
  compensationAssessment          Json?
  preferredRequirementAssessments Json?
  inputBindings                   Json?
  lifecycleProjection             String?
  lifecyclePriorStatus            String?
  lifecycleApplied                Boolean?
  workerProvenance                Json?
  aimFactualExtractionId          String?
  questionRegistryHash            String?
  scoringPolicyHash               String?
  resultBuilderSemanticVersion    String?
  scoringIdentity                 String?
  semanticResultHash              String?
  createdAt                       DateTime              @default(now())
  job                             Job                   @relation(fields: [jobId], references: [id], onDelete: Restrict)
  batchItem                       ScoringBatchItem?     @relation("ScoreEventBatchItem", fields: [batchItemId], references: [id], onDelete: Restrict)
  importedForBatchItem            ScoringBatchItem?     @relation("BatchItemImportedEvent")
  sourceAimEvent                  JobScoreEvent?        @relation("ExperienceSourceAim", fields: [sourceAimEventId], references: [id], onDelete: Restrict)
  experienceEvents                JobScoreEvent[]       @relation("ExperienceSourceAim")
  sourceForBatchItems             ScoringBatchItem[]    @relation("BatchItemSourceAim")
  cleanedJdArtifact               JobScoringArtifact?   @relation(fields: [cleanedJdArtifactId], references: [id], onDelete: Restrict)
  aimFactualExtraction            AimFactualExtraction? @relation("ScoreEventAimFactualExtraction", fields: [aimFactualExtractionId], references: [id], onDelete: Restrict)

  @@index([jobId, createdAt])
  @@index([model, promptVersion])
  @@index([createdAt, passed])
  @@index([requestId, evaluationType])
  @@index([batchId])
  @@index([staleAt, createdAt])
  @@index([jobId, evaluationType, createdAt])
  @@index([sourceAimEventId])
  @@index([cleanedJdArtifactId])
  @@index([aimFactualExtractionId])
  @@index([scoringIdentity])
}

model ScoringBatch {
  id                           String             @id @default(uuid())
  stage                        String
  status                       String             @default("exported")
  schemaVersion                String
  protocolVersion              String
  policyVersion                String
  exportHash                   String             @unique
  manifestHash                 String             @unique
  preferenceHash               String?
  employerOverridesHash        String?
  resumeHash                   String?
  evidenceHash                 String?
  inputVersionsHash            String
  questionRegistryHash         String?
  promptContractHash           String?
  responseContractHash         String?
  runnerProtocolHash           String?
  packetStrategyHash           String?
  scoringPolicyHash            String?
  anonymizationPolicyHash      String?
  resultBuilderSemanticVersion String?
  manifestSnapshot             Json
  exportJson                   String             @db.Text
  exportByteLength             Int
  acceptedResultHash           String?
  createdAt                    DateTime           @default(now())
  expiresAt                    DateTime
  completedAt                  DateTime?
  releasedAt                   DateTime?
  supersededAt                 DateTime?
  supersededReason             String?
  runId                        String?
  runOrdinal                   Int?
  run                          ScoringRun?        @relation(fields: [runId], references: [id], onDelete: Restrict)
  items                        ScoringBatchItem[]

  @@unique([runId, runOrdinal])
  @@index([stage, status, createdAt])
  @@index([expiresAt])
  @@index([runId, status])
}

model ScoringRun {
  id                 String         @id @default(uuid())
  stage              String
  status             String         @default("exported")
  schemaVersion      String
  batchSize          Int
  jobCount           Int
  batchCount         Int
  exportHash         String         @unique
  manifestHash       String         @unique
  exportJson         String         @db.Text
  exportByteLength   Int
  acceptedResultHash String?
  createdAt          DateTime       @default(now())
  expiresAt          DateTime
  completedAt        DateTime?
  releasedAt         DateTime?
  batches            ScoringBatch[]

  @@index([stage, status, createdAt])
  @@index([expiresAt])
}

model ScoringBatchItem {
  id                            String                    @id @default(uuid())
  batchId                       String
  jobId                         String
  stage                         String
  ordinal                       Int
  status                        String                    @default("leased")
  submittedUpdatedAt            DateTime
  sourceJdHash                  String
  inputHash                     String
  inputSnapshot                 Json
  sourceAimEventId              String?
  cleanedArtifactId             String?
  latestPacketPlanHash          String?
  aimFactualExtractionId        String?
  manualRetryOfFailureReceiptId String?
  manualRetryReason             String?
  acceptedResultHash            String?
  acceptedResultSnapshot        Json?
  importedScoreEventId          String?                   @unique
  createdAt                     DateTime                  @default(now())
  importedAt                    DateTime?
  releasedAt                    DateTime?
  batch                         ScoringBatch              @relation(fields: [batchId], references: [id], onDelete: Restrict)
  job                           Job                       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  sourceAimEvent                JobScoreEvent?            @relation("BatchItemSourceAim", fields: [sourceAimEventId], references: [id], onDelete: Restrict)
  cleanedArtifact               JobScoringArtifact?       @relation("BatchItemInputArtifact", fields: [cleanedArtifactId], references: [id], onDelete: Restrict)
  producedArtifact              JobScoringArtifact?       @relation("ProducedArtifact")
  scoreEvent                    JobScoreEvent?            @relation("ScoreEventBatchItem")
  importedScoreEvent            JobScoreEvent?            @relation("BatchItemImportedEvent", fields: [importedScoreEventId], references: [id], onDelete: Restrict)
  aimFactualExtraction          AimFactualExtraction?     @relation("BatchItemAimFactualExtraction", fields: [aimFactualExtractionId], references: [id], onDelete: Restrict)
  producedAimFactualExtraction  AimFactualExtraction?     @relation("ProducedAimFactualExtraction")
  producedAimFailureReceipt     AimScoringFailureReceipt? @relation("ProducedAimFailureReceipt")
  manualRetryOfFailure          AimScoringFailureReceipt? @relation("BatchItemManualRetryFailure", fields: [manualRetryOfFailureReceiptId], references: [id], onDelete: Restrict)

  @@unique([batchId, ordinal])
  @@unique([batchId, jobId])
  @@index([jobId, status])
  @@index([sourceAimEventId])
  @@index([cleanedArtifactId])
  @@index([aimFactualExtractionId])
  @@index([manualRetryOfFailureReceiptId])
}

model AimFactualExtraction {
  id                         String             @id @default(uuid())
  jobId                      String
  schemaVersion              String
  scope                      String
  extractionIdentity         String
  factualVectorHash          String
  sourceJdHash               String
  trustedMetadataHash        String
  questionRegistryVersion    String
  questionRegistryHash       String
  promptContractVersion      String
  promptContractHash         String
  responseContractVersion    String
  responseContractHash       String
  runnerProtocolVersion      String
  runnerProtocolHash         String
  packetStrategyVersion      String
  packetStrategyHash         String
  canonicalizationVersion    String
  anonymizationPolicyVersion String
  anonymizationPolicyHash    String
  extractorSemanticVersion   String
  latestPacketPlanHash       String?
  extractionSnapshot         Json
  workerProvenance           Json
  producedByBatchItemId      String             @unique
  staleAt                    DateTime?
  staleReason                String?
  createdAt                  DateTime           @default(now())
  job                        Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  producingBatchItem         ScoringBatchItem   @relation("ProducedAimFactualExtraction", fields: [producedByBatchItemId], references: [id], onDelete: Restrict)
  consumingBatchItems        ScoringBatchItem[] @relation("BatchItemAimFactualExtraction")
  scoreEvents                JobScoreEvent[]    @relation("ScoreEventAimFactualExtraction")

  @@unique([jobId, extractionIdentity, scope])
  @@index([jobId, createdAt])
  @@index([jobId, staleAt])
  @@index([extractionIdentity])
  @@index([factualVectorHash])
}

model AimScoringFailureReceipt {
  id                        String             @id @default(uuid())
  jobId                     String
  producedByBatchItemId     String             @unique
  sourceIdentity            String
  extractionIdentity        String?
  inputHash                 String
  failureResolutionIdentity String
  protocolVersion           String
  runnerProtocolHash        String
  failureCode               String
  permanence                String
  retrySeriesKey            String
  suppressionKey            String
  suppressionActive         Boolean
  seriesOrdinal             Int
  failureReceiptHash        String             @unique
  failureSnapshot           Json
  createdAt                 DateTime           @default(now())
  clearedAt                 DateTime?
  clearedReason             String?
  clearedActor              String?
  job                       Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  producingBatchItem        ScoringBatchItem   @relation("ProducedAimFailureReceipt", fields: [producedByBatchItemId], references: [id], onDelete: Restrict)
  retryingBatchItems        ScoringBatchItem[] @relation("BatchItemManualRetryFailure")

  @@index([jobId, createdAt])
  @@index([jobId, retrySeriesKey, createdAt])
  @@index([suppressionActive, clearedAt])
}

model JobScoringArtifact {
  id                    String             @id @default(uuid())
  jobId                 String
  kind                  String
  schemaVersion         String
  cleanerVersion        String
  sourceJdHash          String
  contentHash           String
  cleanedText           String             @db.Text
  removedSpans          Json
  coverageAudit         Json
  repairHistory         Json
  producedByBatchItemId String             @unique
  staleAt               DateTime?
  staleReason           String?
  createdAt             DateTime           @default(now())
  job                   Job                @relation(fields: [jobId], references: [id], onDelete: Restrict)
  producingBatchItem    ScoringBatchItem   @relation("ProducedArtifact", fields: [producedByBatchItemId], references: [id], onDelete: Restrict)
  consumingBatchItems   ScoringBatchItem[] @relation("BatchItemInputArtifact")
  scoreEvents           JobScoreEvent[]

  @@index([jobId, createdAt])
  @@index([jobId, staleAt])
  @@index([contentHash])
}

model NativeScoringRequest {
  id                String    @id @default(uuid())
  activeKey         String?   @unique
  status            String    @default("queued")
  phase             String    @default("queued")
  source            String
  progress          String    @default("Waiting for the local Antigravity runner.")
  error             String?
  workerId          String?
  claimedAt         DateTime?
  heartbeatAt       DateTime?
  completedAt       DateTime?
  attempt           Int       @default(0)
  contextJobs       Int       @default(0)
  standardJobs      Int       @default(0)
  contextRuns       Int       @default(0)
  standardRuns      Int       @default(0)
  contextBatchId    String?
  standardBatchId   String?
  // Published by the local watcher, which is the only host with the runner's
  // manifest directory on disk. The dashboard runs on the Pi and cannot read it.
  chunksTotal       Int       @default(0)
  chunksDone        Int       @default(0)
  quarantineRetries Int       @default(0)
  quarantineChunks  Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([updatedAt])
}

model IngestionSourceRun {
  id                   String            @id @default(uuid())
  source               String
  status               String
  seenCount            Int               @default(0)
  insertedCount        Int               @default(0)
  duplicateCount       Int               @default(0)
  filteredCount        Int               @default(0)
  errorCount           Int               @default(0)
  error                String?
  searchQuery          String?
  ingestionMode        String?
  taskId               String?
  providerIncidentId   String?
  queryFamily          String?
  geoLane              String?
  windowStart          DateTime?
  windowEnd            DateTime?
  watermarkAt          DateTime?
  checkpoint           Json?
  processingErrorCount Int               @default(0)
  requestErrorCount    Int               @default(0)
  reconciled           Boolean           @default(false)
  startedAt            DateTime          @default(now())
  finishedAt           DateTime?
  durationMs           Int?
  createdAt            DateTime          @default(now())
  task                 IngestionTask?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  providerIncident     ProviderIncident? @relation(fields: [providerIncidentId], references: [id], onDelete: SetNull)

  @@index([source, createdAt])
  @@index([status, createdAt])
  @@index([taskId, createdAt])
  @@index([geoLane, createdAt])
}

/// Durable unit of ingestion work. The task key includes source, normalized
/// query family, geography lane, time-window policy, and ingestion mode.
model IngestionTask {
  id                   String                 @id @default(uuid())
  taskKey              String                 @unique
  source               String
  queryFamily          String?
  searchQuery          String?
  geoLane              String
  ingestionMode        String
  taskKind             String                 @default("search")
  lifecycleStatus      String                 @default("active")
  retiredAt            DateTime?
  status               String                 @default("queued")
  nextRunAt            DateTime               @default(now())
  windowStart          DateTime?
  windowEnd            DateTime?
  watermarkAt          DateTime?
  cursor               Json?
  leaseToken           String?                @unique
  leaseOwner           String?
  leaseStartedAt       DateTime?
  heartbeatAt          DateTime?
  leaseExpiresAt       DateTime?
  attempt              Int                    @default(0)
  requestCount         Int                    @default(0)
  seenCount            Int                    @default(0)
  insertedCount        Int                    @default(0)
  duplicateCount       Int                    @default(0)
  filteredCount        Int                    @default(0)
  processingErrorCount Int                    @default(0)
  providerErrorCount   Int                    @default(0)
  lastError            String?
  lastStartedAt        DateTime?
  lastCompletedAt      DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  runs                 IngestionSourceRun[]
  events               JobPipelineEvent[]
  observations         JobSourceObservation[]

  @@index([status, nextRunAt])
  @@index([taskKind, lifecycleStatus, status, nextRunAt])
  @@index([source, nextRunAt])
  @@index([leaseExpiresAt])
}

/// Provider health and request budgets survive process restarts and deploys.
model ProviderCircuit {
  provider              String    @id
  state                 String    @default("closed")
  openUntil             DateTime?
  consecutiveFailures   Int       @default(0)
  dailyLimit            Int?
  monthlyLimit          Int?
  dailyUsed             Int       @default(0)
  monthlyUsed           Int       @default(0)
  budgetDay             String?
  budgetMonth           String?
  lastError             String?
  lastFailureAt         DateTime?
  lastSuccessAt         DateTime?
  requestLeaseToken     String?   @unique
  requestLeaseOwner     String?
  requestLeaseExpiresAt DateTime?
  updatedAt             DateTime  @updatedAt

  @@index([state, openUntil])
  @@index([requestLeaseExpiresAt])
}

/// One provider-level incident can affect many query tasks. Stats should show
/// the incident once and expose the affected-query/occurrence counters.
model ProviderIncident {
  id                 String                         @id @default(uuid())
  incidentKey        String                         @unique
  provider           String
  classification     String
  status             String                         @default("open")
  message            String
  affectedQueryCount Int                            @default(1)
  occurrenceCount    Int                            @default(1)
  firstSeenAt        DateTime                       @default(now())
  lastSeenAt         DateTime                       @default(now())
  resolvedAt         DateTime?
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt
  runs               IngestionSourceRun[]
  affectedTasks      ProviderIncidentAffectedTask[]

  @@index([status, lastSeenAt])
  @@index([provider, lastSeenAt])
}

/// Distinct task/query evidence behind an incident's affectedQueryCount.
model ProviderIncidentAffectedTask {
  id          String           @id @default(uuid())
  incidentId  String
  taskKey     String
  queryFamily String?
  geoLane     String?
  firstSeenAt DateTime         @default(now())
  incident    ProviderIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, taskKey])
  @@index([incidentId, firstSeenAt])
}

/// Immutable stage evidence. `eventKey` is deterministic so retries are
/// idempotent without making events mutable.
model JobPipelineEvent {
  id          String         @id @default(uuid())
  eventKey    String         @unique
  jobId       String?
  taskId      String?
  eventType   String
  stage       String?
  source      String?
  sourceId    String?
  queryFamily String?
  geoLane     String?
  details     Json?
  occurredAt  DateTime       @default(now())
  createdAt   DateTime       @default(now())
  job         Job?           @relation(fields: [jobId], references: [id], onDelete: SetNull)
  task        IngestionTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([eventType, occurredAt])
  @@index([jobId, occurredAt])
  @@index([taskId, occurredAt])
  @@index([source, occurredAt])
}

model OutreachTarget {
  id               String   @id @default(uuid())
  publicIdentifier String?
  firstName        String
  lastName         String
  headline         String?
  company          String?
  linkedinUrl      String   @unique
  about            String?
  locationText     String?
  status           String   @default("inbox")
  generatedPitch   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  email            String?
  generatedNote    String?
}

model PipelineState {
  id              String    @id @default("global")
  isRunning       Boolean   @default(false)
  schedulePaused  Boolean   @default(false)
  // When the pause lapses. NULL while `schedulePaused` is true means the pause
  // was made deliberately indefinite; otherwise the scheduler resumes itself
  // once this passes, so a forgotten Stop cannot silently halt ingestion.
  pausedUntil     DateTime?
  currentStep     String    @default("Idle")
  stepProgress    String    @default("No pipeline run has started.")
  lastUpdated     DateTime  @default(now())
  // The lock lives here rather than on a host's filesystem: the Mac and the Pi
  // share this database, and a local lock cannot exclude the other host.
  lockToken       String?
  lockOwner       String?
  lockHeartbeatAt DateTime?
}

model JobStatusHistory {
  id        String   @id @default(uuid())
  jobId     String
  status    String
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([status, createdAt])
}

model JobScoringStatusHistory {
  id            String   @id
  jobId         String
  scoringStatus String
  createdAt     DateTime @default(now())
  job           Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
  @@index([scoringStatus, createdAt])
}

model StatsTrackingEpoch {
  id        String   @id
  startedAt DateTime @default(now())
}

/// Durable per-key rate-limit cooldowns. Keys are stored as a salted hash only:
/// the value never needs to be read back, just matched.
model ApiKeyCooldown {
  id        String   @id @default(uuid())
  service   String
  keyHash   String
  readyAt   DateTime
  reason    String?
  updatedAt DateTime @updatedAt

  @@unique([service, keyHash])
  @@index([service, readyAt])
}

/// Append-only trail of pipeline lifecycle transitions. PipelineState itself is
/// a single mutable row, so without this a stall leaves no evidence behind.
model PipelineStateEvent {
  id             String    @id @default(uuid())
  occurredAt     DateTime  @default(now())
  /// started | stopped | paused | resumed | step | warning | error
  eventType      String
  currentStep    String
  stepProgress   String?
  isRunning      Boolean
  schedulePaused Boolean   @default(false)
  pausedUntil    DateTime?
  lockOwner      String?
  detail         String?

  @@index([occurredAt])
  @@index([eventType, occurredAt])
}
