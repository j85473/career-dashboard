[Unit]
Description=Career Dashboard bounded ATS first-collection admission
Wants=network-online.target
After=network-online.target postgresql.service career-dashboard.service
ConditionPathExists=/etc/career-dashboard/production-enabled
ConditionPathExists=!/var/lib/m70-auto-maintenance/hold-background

[Service]
Type=oneshot
User=career-dashboard
WorkingDirectory=/opt/career-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=DATABASE_RUNTIME_HOST=127.0.0.1
EnvironmentFile=/etc/career-dashboard/runtime.env
EnvironmentFile=/etc/career-dashboard/acquisition-release.env
ExecStart=/usr/local/bin/node scripts/with-env.mjs /usr/local/bin/node --import tsx scripts/control_ats_first_collections.ts --tick
TimeoutStartSec=2min
UMask=0077
NoNewPrivileges=true
