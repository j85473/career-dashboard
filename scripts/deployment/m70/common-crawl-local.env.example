# Install deliberately as /etc/career-dashboard/common-crawl-local.env.
# This file overrides Athena selection in both existing discovery units.
ATS_DISCOVERY_SOURCE=local
ATS_DISCOVERY_LOCAL_MOUNT=/media/nas
# Refuse new writes before consuming the last 20 GiB of the HDD.
ATS_DISCOVERY_LOCAL_RESERVE_BYTES=21474836480
# One direct-file request at a time, with a pause between blocks.
ATS_DISCOVERY_LOCAL_DELAY_MS=1000
