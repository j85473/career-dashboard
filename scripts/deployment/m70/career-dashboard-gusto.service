[Unit]
Description=Career Dashboard Gusto board browser sweep
After=network-online.target career-dashboard.service
Wants=network-online.target
ConditionPathExists=/etc/career-dashboard/production-enabled
ConditionPathExists=/etc/career-dashboard/cloakbrowser.env

[Service]
Type=oneshot
User=career-dashboard
Group=career-dashboard
WorkingDirectory=/opt/career-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/career-dashboard
Environment=CLOAKBROWSER_PROFILE_DIR=/var/lib/career-dashboard/data/runtime/cloakbrowser-gusto-profile
EnvironmentFile=/etc/career-dashboard/runtime.env
EnvironmentFile=/etc/career-dashboard/acquisition-release.env
EnvironmentFile=/etc/career-dashboard/cloakbrowser.env
# One licensed browser session is shared with the canonical resolver. If its
# session is occupied, the next timer pass retries without overlapping it.
ExecStart=/usr/bin/flock -n -E 0 /var/lib/career-dashboard/data/runtime/cloakbrowser-license.lock /usr/bin/xvfb-run -a -s "-screen 0 1920x1080x24" /usr/local/bin/node scripts/with-env.mjs /usr/local/bin/node --import tsx scripts/sweep_gusto_boards.ts --limit=8
TimeoutStartSec=20min
NoNewPrivileges=true
PrivateTmp=true
UMask=0077
