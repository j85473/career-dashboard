[Unit]
Description=Protect Career Dashboard database disk capacity
After=local-fs.target
ConditionPathExists=/etc/career-dashboard/production-enabled

[Service]
Type=oneshot
User=root
Group=career-dashboard
ExecStart=/usr/bin/python3 /opt/career-dashboard/scripts/deployment/m70-storage-monitor.py
TimeoutStartSec=10
UMask=0027
NoNewPrivileges=true
