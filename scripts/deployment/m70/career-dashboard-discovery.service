[Unit]
Description=Career Dashboard Common Crawl ATS board discovery
After=career-dashboard.service
ConditionPathExists=/etc/career-dashboard/production-enabled
[Service]
Type=oneshot
User=career-dashboard
WorkingDirectory=/opt/career-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/career-dashboard/runtime.env
EnvironmentFile=/etc/career-dashboard/acquisition-release.env
# The optional, root-owned file holds the restricted Athena worker credential.
# Its absence leaves an intentionally explicit direct-source recovery path,
# rather than putting a secret in the release archive.
EnvironmentFile=-/etc/career-dashboard/athena-discovery.env
# The weekly and exhaustive paths share the same durable receipt engine and
# lock. A completed audit checks for only newly published indexes; it never
# silently falls back to the legacy API crawler.
ExecStart=/usr/bin/flock -n -E 0 /var/lib/career-dashboard/data/runtime/discovery.lock /usr/local/bin/node scripts/with-env.mjs /usr/local/bin/npm run ats:discovery:audit
TimeoutStartSec=infinity
NoNewPrivileges=true
UMask=0077
