# The standing board-pruning review.
#
# The reporting arms judge evidence already in the database and print an
# approved command for a human; they never retire a board, because an excluded
# board is never re-judged and a timer must not hold that approval.
#
# One arm is different and does act: the liveness arm contacts every demoted
# board and decides from what the board says today, promoting the ones that
# still carry postings and retiring the ones that are gone. Its brakes live
# beside its code, not here, so this unit carries no authorisation flags of its
# own -- what a run may do is decided per arm in the review.
#
# Deliberately does not require watchdog-repair-enabled: that flag guards the
# repair watchdog's unattended writes to acquisition state, which this does not
# touch.
[Unit]
Description=Career Dashboard ATS board-pruning review on M70s
Wants=network-online.target
After=network-online.target postgresql.service career-dashboard.service
ConditionPathExists=/etc/career-dashboard/production-enabled

[Service]
Type=oneshot
User=career-dashboard
WorkingDirectory=/opt/career-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=DATABASE_RUNTIME_HOST=127.0.0.1
EnvironmentFile=/etc/career-dashboard/runtime.env
EnvironmentFile=/etc/career-dashboard/acquisition-release.env
ExecStart=/usr/local/bin/node scripts/with-env.mjs /usr/local/bin/node --import tsx scripts/review_ats_board_pruning.ts
# The reporting arms each scan the whole board catalog; the geography arm alone
# takes ~1 min. The liveness arm additionally contacts every demoted board one
# at a time across twelve providers, several of which throttle, so it is the
# long pole: about 20 minutes for 9,000 boards and slower when providers are
# pushing back.
TimeoutStartSec=2h
KillMode=control-group
UMask=0077
NoNewPrivileges=true
