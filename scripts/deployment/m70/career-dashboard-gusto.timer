[Unit]
Description=Frequent Gusto paid-search browser sweeps
ConditionPathExists=/etc/career-dashboard/production-enabled
ConditionPathExists=/etc/career-dashboard/cloakbrowser.env

[Timer]
OnBootSec=10min
OnUnitInactiveSec=10min
RandomizedDelaySec=2min
Persistent=true

[Install]
WantedBy=timers.target
