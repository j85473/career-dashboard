[Unit]
Description=Career Dashboard on M70s
Wants=network-online.target
After=network-online.target tailscaled.service postgresql.service
ConditionPathExists=/etc/career-dashboard/production-enabled

[Service]
Type=simple
User=career-dashboard
WorkingDirectory=/opt/career-dashboard
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
Environment=DATABASE_RUNTIME_HOST=127.0.0.1
EnvironmentFile=/etc/career-dashboard/runtime.env
EnvironmentFile=/etc/career-dashboard/acquisition-release.env
# Supervise Next directly so shutdown does not leave an npm child behind.
ExecStart=/usr/local/bin/node node_modules/next/dist/bin/next start -H 100.107.116.123 -p 3000
Restart=always
RestartSec=10
SuccessExitStatus=130 143
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
