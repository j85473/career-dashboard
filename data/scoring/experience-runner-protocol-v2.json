{
  "schemaVersion": "career-dashboard-experience-runner-protocol-v2",
  "runnerProtocolVersion": "career-dashboard-experience-runner-protocol-v2",
  "controllerVersion": "career-dashboard-experience-controller-v3",
  "defaultModel": "gpt-5.6-terra",
  "hardGateEffort": "medium",
  "holisticEffort": "high",
  "invocationTimeoutSeconds": 600,
  "maximumOutputUtf8Bytes": 16000,
  "maximumHardRequirements": 20,
  "retry": {
    "enabled": false,
    "maximumAttemptsPerPhase": 1
  },
  "workerIsolation": {
    "ephemeral": true,
    "readOnly": true,
    "toolsDisabled": true,
    "memoryDisabled": true
  }
}
