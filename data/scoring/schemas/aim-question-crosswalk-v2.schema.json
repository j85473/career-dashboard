{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aim-question-crosswalk-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceQuestionBankVersion",
    "targetQuestionRegistryVersion",
    "expectedDispositionCounts",
    "entries"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aim-question-crosswalk-v2"
    },
    "sourceQuestionBankVersion": {
      "const": "aim-stage2-question-bank-342-v1"
    },
    "targetQuestionRegistryVersion": {
      "const": "aim-question-registry-v2"
    },
    "expectedDispositionCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keep",
        "merge",
        "replace",
        "remove"
      ],
      "properties": {
        "keep": {
          "const": 42
        },
        "merge": {
          "const": 212
        },
        "replace": {
          "const": 35
        },
        "remove": {
          "const": 53
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 342,
      "maxItems": 342,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "disposition",
        "targetIds",
        "rationale"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^S2\\.F(?:[1-9]|1[01])\\.Q(?:[1-9]|[1-3][0-9]|4[0-3])$",
          "maxLength": 20
        },
        "disposition": {
          "enum": [
            "keep",
            "merge",
            "replace",
            "remove"
          ]
        },
        "targetIds": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^S2\\.(?:CML|BA|LI|TX|SC|PD|CP|TR)\\.Q[0-9]{2}$",
            "maxLength": 20
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
