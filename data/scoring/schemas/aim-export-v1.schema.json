{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-dashboard-aim-export-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "batch", "preferences", "jobs"],
  "properties": {
    "schemaVersion": { "const": "career-dashboard-aim-export-v1" },
    "batch": { "$ref": "#/$defs/batch" },
    "preferences": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policyHash", "employerOverridesHash", "employerOverrides"],
      "properties": {
        "policyHash": { "$ref": "#/$defs/hash" },
        "employerOverridesHash": { "$ref": "#/$defs/hash" },
        "employerOverrides": { "type": "object" }
      }
    },
    "jobs": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "format": "uuid", "maxLength": 200 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "batch": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "stage", "createdAt", "expiresAt", "protocolVersion", "policyVersion", "manifestHash"],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" }, "stage": { "const": "aim" },
        "createdAt": { "$ref": "#/$defs/timestamp" }, "expiresAt": { "$ref": "#/$defs/timestamp" },
        "protocolVersion": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,200}$" },
        "policyVersion": { "const": "aim-policy-v1" }, "manifestHash": { "$ref": "#/$defs/hash" }
      }
    },
    "job": {
      "type": "object", "additionalProperties": false,
      "required": ["jobId", "ordinal", "submittedUpdatedAt", "company", "title", "location", "sourceUrl", "originalJd", "sourceJdHash", "metadataHash", "inputHash"],
      "properties": {
        "jobId": { "$ref": "#/$defs/uuid" }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 49 },
        "submittedUpdatedAt": { "$ref": "#/$defs/timestamp" },
        "company": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "title": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "location": { "type": ["string", "null"], "maxLength": 10000 },
        "sourceUrl": { "type": ["string", "null"], "maxLength": 10000 },
        "originalJd": { "type": "string", "minLength": 1, "maxLength": 250000 },
        "sourceJdHash": { "$ref": "#/$defs/hash" }, "metadataHash": { "$ref": "#/$defs/hash" }, "inputHash": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
