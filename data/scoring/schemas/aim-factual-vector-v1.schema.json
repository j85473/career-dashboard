{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-dashboard-aim-factual-vector-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "sourceJdHash",
    "trustedMetadataHash",
    "sourceIdentity",
    "questionRegistryVersion",
    "questionRegistryHash",
    "promptContractVersion",
    "promptContractHash",
    "responseContractVersion",
    "responseContractHash",
    "runnerProtocolVersion",
    "runnerProtocolHash",
    "packetStrategyVersion",
    "packetStrategyHash",
    "canonicalizationVersion",
    "anonymizationPolicyVersion",
    "anonymizationPolicyHash",
    "extractorSemanticVersion",
    "extractionIdentity",
    "answers",
    "evidenceCatalog",
    "factualVectorHash",
    "provenance"
  ],
  "properties": {
    "schemaVersion": {
      "const": "career-dashboard-aim-factual-vector-v1"
    },
    "scope": {
      "enum": [
        "stage1",
        "compensation_preflight",
        "complete"
      ]
    },
    "sourceJdHash": {
      "$ref": "#/$defs/hash"
    },
    "trustedMetadataHash": {
      "$ref": "#/$defs/hash"
    },
    "sourceIdentity": {
      "$ref": "#/$defs/hash"
    },
    "questionRegistryVersion": {
      "$ref": "#/$defs/version"
    },
    "questionRegistryHash": {
      "$ref": "#/$defs/hash"
    },
    "promptContractVersion": {
      "$ref": "#/$defs/version"
    },
    "promptContractHash": {
      "$ref": "#/$defs/hash"
    },
    "responseContractVersion": {
      "$ref": "#/$defs/version"
    },
    "responseContractHash": {
      "$ref": "#/$defs/hash"
    },
    "runnerProtocolVersion": {
      "$ref": "#/$defs/version"
    },
    "runnerProtocolHash": {
      "$ref": "#/$defs/hash"
    },
    "packetStrategyVersion": {
      "$ref": "#/$defs/version"
    },
    "packetStrategyHash": {
      "$ref": "#/$defs/hash"
    },
    "canonicalizationVersion": {
      "$ref": "#/$defs/version"
    },
    "anonymizationPolicyVersion": {
      "$ref": "#/$defs/version"
    },
    "anonymizationPolicyHash": {
      "$ref": "#/$defs/hash"
    },
    "extractorSemanticVersion": {
      "$ref": "#/$defs/version"
    },
    "extractionIdentity": {
      "$ref": "#/$defs/hash"
    },
    "answers": {
      "type": "array",
      "minItems": 7,
      "maxItems": 349,
      "items": {
        "$ref": "#/$defs/answer"
      }
    },
    "evidenceCatalog": {
      "type": "array",
      "maxItems": 698,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "factualVectorHash": {
      "$ref": "#/$defs/hash"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uuid": {
      "type": "string",
      "format": "uuid",
      "maxLength": 200
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,200}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "questionId": {
      "type": "string",
      "pattern": "^(?:S1\\.Q0[1-7]|S2\\.F(?:[1-9]|1[01])\\.Q(?:[1-9]|[1-3][0-9]|4[0-3]))$",
      "maxLength": 20
    },
    "answer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "questionId",
        "answer",
        "evidenceIds"
      ],
      "properties": {
        "questionId": {
          "$ref": "#/$defs/questionId"
        },
        "answer": {
          "enum": [
            "yes",
            "no",
            "unsupported"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "occurrence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startCodePoint",
        "endCodePoint"
      ],
      "properties": {
        "startCodePoint": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1500000
        },
        "endCodePoint": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1500000
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "source",
        "field",
        "exactQuote",
        "occurrences"
      ],
      "properties": {
        "evidenceId": {
          "$ref": "#/$defs/hash"
        },
        "source": {
          "enum": [
            "original_jd",
            "trusted_metadata"
          ]
        },
        "field": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "company",
            "title",
            "location"
          ]
        },
        "exactQuote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "occurrences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/occurrence"
          }
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attemptOrdinal",
        "effort",
        "startedAt",
        "completedAt",
        "outcome",
        "failureCategory",
        "invocationReceipt"
      ],
      "properties": {
        "attemptOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1
        },
        "effort": {
          "const": "medium"
        },
        "startedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "completedAt": {
          "$ref": "#/$defs/timestamp"
        },
        "outcome": {
          "enum": [
            "accepted",
            "invocation_failed",
            "output_invalid",
            "evidence_invalid"
          ]
        },
        "failureCategory": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "invocationReceipt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "packetReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseOrdinal",
        "physicalOrdinal",
        "packetPath",
        "packetManifestHash",
        "packetInputHash",
        "model",
        "attempts",
        "acceptedAttempt",
        "reusedFromPacketManifestHash"
      ],
      "properties": {
        "baseOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "physicalOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 345
        },
        "packetPath": {
          "type": "string",
          "pattern": "^(?:[0-9]|1[0-5])(?:[LR]{0,16})$",
          "maxLength": 20
        },
        "packetManifestHash": {
          "$ref": "#/$defs/hash"
        },
        "packetInputHash": {
          "$ref": "#/$defs/hash"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "attempts": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "acceptedAttempt": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1
        },
        "reusedFromPacketManifestHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "sourceExtractionId",
        "packetPlanHash",
        "packets"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "fresh",
            "packet_cache_reuse",
            "dashboard_reuse"
          ]
        },
        "sourceExtractionId": {
          "anyOf": [
            {
              "$ref": "#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "packetPlanHash": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "packets": {
          "type": "array",
          "maxItems": 349,
          "items": {
            "$ref": "#/$defs/packetReceipt"
          }
        }
      }
    }
  }
}
