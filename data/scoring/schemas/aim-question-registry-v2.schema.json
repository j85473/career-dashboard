{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aim-question-registry-v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "questionRegistryVersion",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aim-question-registry-v2"
    },
    "questionRegistryVersion": {
      "const": "aim-question-registry-v2"
    },
    "questions": {
      "type": "array",
      "minItems": 349,
      "maxItems": 349,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "evidenceCardinality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumExactExcerpts",
        "maximumExactExcerpts"
      ],
      "properties": {
        "minimumExactExcerpts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "maximumExactExcerpts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "evidenceRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "yes",
        "no",
        "unsupported",
        "maximumExcerptCodePoints",
        "maximumTotalExcerptCodePoints"
      ],
      "properties": {
        "yes": {
          "$ref": "#/$defs/evidenceCardinality"
        },
        "no": {
          "$ref": "#/$defs/evidenceCardinality"
        },
        "unsupported": {
          "$ref": "#/$defs/evidenceCardinality"
        },
        "maximumExcerptCodePoints": {
          "const": 320
        },
        "maximumTotalExcerptCodePoints": {
          "const": 480
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "wording",
        "privatePhase",
        "allowedSources",
        "allowedMetadataFields",
        "evidenceRule",
        "parserInput"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:S1\\.Q0[1-7]|S2\\.F(?:[1-9]|1[01])\\.Q(?:[1-9]|[1-3][0-9]|4[0-3]))$",
          "maxLength": 20
        },
        "wording": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "privatePhase": {
          "enum": [
            "stage1",
            "stage2"
          ]
        },
        "allowedSources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "original_jd",
              "trusted_metadata"
            ]
          }
        },
        "allowedMetadataFields": {
          "type": "array",
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "company",
              "title",
              "location"
            ]
          }
        },
        "evidenceRule": {
          "$ref": "#/$defs/evidenceRule"
        },
        "parserInput": {
          "enum": [
            "stage1_fact",
            "score_fact",
            "compensation_fact",
            "travel_fact"
          ]
        }
      }
    }
  }
}
