{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factual-response-v1",
  "schemaVersion": "aim-factual-worker-response-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answers"
  ],
  "properties": {
    "answers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 104,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "answer",
          "supportingText"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 104
          },
          "answer": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsupported"
            ]
          },
          "supportingText": {
            "type": "array",
            "minItems": 0,
            "maxItems": 2,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 320
            }
          }
        }
      }
    }
  }
}
