{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "career-dashboard-experience-result-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "batch", "resumeHash", "evidenceHash", "runner", "results", "resultHash"],
  "properties": {
    "schemaVersion": { "const": "career-dashboard-experience-result-v1" },
    "batch": { "$ref": "#/$defs/batchEcho" }, "resumeHash": { "$ref": "#/$defs/hash" }, "evidenceHash": { "$ref": "#/$defs/hash" },
    "runner": { "$ref": "#/$defs/provenance" },
    "results": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/result" } },
    "resultHash": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "uuid": { "type": "string", "format": "uuid", "maxLength": 200 },
    "timestamp": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "span": { "type": "object", "additionalProperties": false, "required": ["startCodePoint", "endCodePoint", "exactQuote"], "properties": { "startCodePoint": { "type": "integer", "minimum": 0 }, "endCodePoint": { "type": "integer", "minimum": 0 }, "exactQuote": { "type": "string", "maxLength": 10000 } } },
    "batchEcho": { "type": "object", "additionalProperties": false, "required": ["id", "stage", "protocolVersion", "policyVersion", "manifestHash"], "properties": { "id": { "$ref": "#/$defs/uuid" }, "stage": { "const": "experience" }, "protocolVersion": { "type": "string", "maxLength": 200 }, "policyVersion": { "const": "experience-policy-v1" }, "manifestHash": { "$ref": "#/$defs/hash" } } },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["runnerVersion", "model", "effort", "promptVersion", "startedAt", "completedAt", "invocationReceipt"], "properties": { "runnerVersion": { "type": "string", "maxLength": 200 }, "model": { "type": "string", "maxLength": 200 }, "effort": { "enum": ["medium", "high"] }, "promptVersion": { "type": "string", "maxLength": 200 }, "startedAt": { "$ref": "#/$defs/timestamp" }, "completedAt": { "$ref": "#/$defs/timestamp" }, "invocationReceipt": { "type": "string", "minLength": 1, "maxLength": 2000 } } },
    "workerReceipt": { "type": "object", "additionalProperties": false, "required": ["phase", "model", "effort", "promptVersion", "startedAt", "completedAt", "invocationReceipt"], "properties": { "phase": { "enum": ["requirement_extractor", "requirement_coverage_auditor", "evidence_evaluator", "targeted_repair"] }, "model": { "type": "string", "maxLength": 200 }, "effort": { "enum": ["medium", "high"] }, "promptVersion": { "type": "string", "maxLength": 200 }, "startedAt": { "$ref": "#/$defs/timestamp" }, "completedAt": { "$ref": "#/$defs/timestamp" }, "invocationReceipt": { "type": "string", "minLength": 1, "maxLength": 2000 } } },
    "leaf": { "type": "object", "additionalProperties": false, "required": ["leafId", "normalizedMeaning", "source"], "properties": { "leafId": { "type": "string", "maxLength": 200 }, "normalizedMeaning": { "type": "string", "minLength": 1, "maxLength": 10000 }, "source": { "$ref": "#/$defs/span" } } },
    "criterion": { "type": "object", "additionalProperties": false, "required": ["criterionId", "classification", "category", "operator", "normalizedMeaning", "source", "requirementCue", "leaves", "alternatives"], "properties": { "criterionId": { "type": "string", "maxLength": 200 }, "classification": { "enum": ["required", "preferred"] }, "category": { "enum": ["substantive", "role_defining_credential", "administrative", "subjective_boilerplate"] }, "operator": { "enum": ["single", "all", "any"] }, "normalizedMeaning": { "type": "string", "minLength": 1, "maxLength": 10000 }, "source": { "$ref": "#/$defs/span" }, "requirementCue": { "type": "string", "maxLength": 10000 }, "leaves": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/leaf" } }, "alternatives": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 10000 } } } },
    "evidenceBinding": { "type": "object", "additionalProperties": false, "required": ["evidenceId", "fieldPath", "startCodePoint", "endCodePoint", "exactQuote", "relation", "note"], "properties": { "evidenceId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$" }, "fieldPath": { "enum": ["evidenceText", "scopeNotes", "employer", "roleTitle", "dateRange", "baselineSection", "notes"] }, "startCodePoint": { "type": "integer", "minimum": 0 }, "endCodePoint": { "type": "integer", "minimum": 0 }, "exactQuote": { "type": "string", "minLength": 1, "maxLength": 10000 }, "relation": { "enum": ["supports_complete", "supports_partial", "conflicts"] }, "note": { "type": ["string", "null"], "maxLength": 2000 } } },
    "leafOutcome": { "type": "object", "additionalProperties": false, "required": ["leafId", "outcome", "support", "conflict", "rationale"], "properties": { "leafId": { "type": "string", "maxLength": 200 }, "outcome": { "enum": ["direct", "partial", "cannot_evaluate", "does_not_meet"] }, "support": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/evidenceBinding" } }, "conflict": { "type": "array", "maxItems": 1024, "items": { "$ref": "#/$defs/evidenceBinding" } }, "rationale": { "type": "string", "maxLength": 2000 } } },
    "criterionOutcome": { "type": "object", "additionalProperties": false, "required": ["criterionId", "outcome", "leaves"], "properties": { "criterionId": { "type": "string", "maxLength": 200 }, "outcome": { "enum": ["direct", "partial", "cannot_evaluate", "does_not_meet", "excluded"] }, "leaves": { "type": "array", "maxItems": 256, "items": { "$ref": "#/$defs/leafOutcome" } } } },
    "evaluation": { "type": "object", "additionalProperties": false, "required": ["kind", "criteria", "coverageAudit", "repairHistory", "outcomes", "decision", "blockingCriteria", "preferredPoints", "experienceFitScore"], "properties": { "kind": { "const": "evaluation" }, "criteria": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/criterion" } }, "coverageAudit": { "type": "object", "additionalProperties": false, "required": ["complete", "findings"], "properties": { "complete": { "type": "boolean" }, "findings": { "type": "array", "maxItems": 1024, "items": { "type": "string", "maxLength": 2000 } } } }, "repairHistory": { "type": "array", "maxItems": 2, "items": { "type": "string", "maxLength": 2000 } }, "outcomes": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/criterionOutcome" } }, "decision": { "enum": ["qualified", "hard_requirement_not_fully_supported"] }, "blockingCriteria": { "type": "array", "maxItems": 128, "items": { "type": "object", "additionalProperties": false, "required": ["criterionId", "outcome"], "properties": { "criterionId": { "type": "string", "maxLength": 200 }, "outcome": { "enum": ["partial", "cannot_evaluate", "does_not_meet"] } } } }, "preferredPoints": { "type": ["integer", "null"], "minimum": 0, "maximum": 20 }, "experienceFitScore": { "type": ["integer", "null"], "minimum": 80, "maximum": 100 } } },
    "safeFailure": { "type": "object", "additionalProperties": false, "required": ["kind", "code", "detail"], "properties": { "kind": { "const": "safe_failure" }, "code": { "enum": ["source_unusable", "coverage_incomplete", "result_untrustworthy", "contract_limit_exceeded", "worker_invocation_failed"] }, "detail": { "type": "string", "minLength": 1, "maxLength": 2000 } } },
    "result": { "type": "object", "additionalProperties": false, "required": ["jobId", "ordinal", "inputHash", "aimEventId", "aimEventHash", "cleanedArtifactId", "cleanedArtifactHash", "workers", "result", "resultHash"], "properties": { "jobId": { "$ref": "#/$defs/uuid" }, "ordinal": { "type": "integer", "minimum": 0, "maximum": 49 }, "inputHash": { "$ref": "#/$defs/hash" }, "aimEventId": { "$ref": "#/$defs/uuid" }, "aimEventHash": { "$ref": "#/$defs/hash" }, "cleanedArtifactId": { "$ref": "#/$defs/uuid" }, "cleanedArtifactHash": { "$ref": "#/$defs/hash" }, "workers": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/workerReceipt" } }, "result": { "oneOf": [{ "$ref": "#/$defs/evaluation" }, { "$ref": "#/$defs/safeFailure" }] }, "resultHash": { "$ref": "#/$defs/hash" } } }
  }
}
