!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (template .env.example stays tracked)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
prisma/*.db

# Personal & Logs
# data/resumes/ is intentionally tracked. The scoring evaluator is byte-bound to
# the baseline resume (assertEvaluatorResumeMatches), and data/resumes was both
# gitignored and rsync-excluded, so the file could never reach the Pi — scoring
# aborted there while CI stayed green. The resume is public on LinkedIn, Indeed,
# and ZipRecruiter, so tracking it costs nothing and keeps the binding intact.
data/discover_logs.txt
discover_progress.json
PIPELINE_FLOW.html

# Agent Artifacts
.agents/*
!.agents/AGENTS.md
!.agents/agents/
!.agents/agents/**
!.agents/hooks.json
# .agents/minified_evidence.json is intentionally tracked, for the same reason
# data/resumes is (see above). prepare_native_scoring_phase.ts reads it at
# runtime via requiredProjectFile() and requires it to be canonically identical
# to the block baked into the evaluator prompt. Deploy rsyncs the CI workspace
# with --delete, so leaving it untracked actively removes it from the Pi. Its
# contents are already public in this repo — agent.md bakes in the same JSON.
!.agents/minified_evidence.json
AGENTS.md
!.agents/AGENTS.md
CLAUDE.md

# Local Claude Code state (per-machine tool permissions, not shared config)
.claude/

# Scripts & Archives
scripts/archive/

# Root DBs
*.db
*.backup*

# Hygiene & Generated Files
*.log
*.bak
prisma/generated/

.env
scratch/

# Root-only one-off diagnostics. Durable tools belong in scripts/ or tests/.
/scratch*.ts
/test_*.ts
/test_*.js
/mammoth_*.txt

# Runtime state and local operational exports
.pipeline_state.json
data/runtime/
data/scoring/results/
/docs/CANDIDATE_EVIDENCE_GAPS.md
scores_backup*.json
*.diagnostic.json

chunks/
deepseek_jobs.json
